{
  "info": {
    "name": "FitnessTracker - User API",
    "description": "CRUD operations for the User resource in the FitnessTracker application (LAB04).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get all users (full)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users"]
        },
        "description": "Returns full details (id, firstName, lastName, birthdate, email) for every user."
      },
      "response": []
    },
    {
      "name": "Get all users (simple)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/users/simple",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "simple"]
        },
        "description": "Returns only id, firstName and lastName for every user."
      },
      "response": []
    },
    {
      "name": "Get user by ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "1"]
        },
        "description": "Returns full details for the user with the given ID. Replace '1' with the desired ID."
      },
      "response": []
    },
    {
      "name": "Search users by email fragment",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/users/email?email=test",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "email"],
          "query": [
            {
              "key": "email",
              "value": "test",
              "description": "Case-insensitive fragment of the email address to search for."
            }
          ]
        },
        "description": "Returns a list of users whose email contains the given fragment (case-insensitive). Each result includes only id and email."
      },
      "response": []
    },
    {
      "name": "Get users older than date",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/v1/users/older/2000-01-01",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "older", "2000-01-01"]
        },
        "description": "Returns full details for all users born before the given date (yyyy-MM-dd). I.e. users older than that date."
      },
      "response": []
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1990-05-15\",\n  \"email\": \"john.doe@example.com\"\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/users",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users"]
        },
        "description": "Creates a new user. Returns 201 Created with the created user body."
      },
      "response": []
    },
    {
      "name": "Update user",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1992-08-20\",\n  \"email\": \"jane.doe@example.com\"\n}",
          "options": {
            "raw": { "language": "json" }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/v1/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "1"]
        },
        "description": "Updates all fields of an existing user. Replace '1' with the target user ID."
      },
      "response": []
    },
    {
      "name": "Delete user",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v1/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "users", "1"]
        },
        "description": "Deletes the user with the given ID. Returns 204 No Content on success. Replace '1' with the target user ID."
      },
      "response": []
    }
  ]
}
